# --- Required -----------------------------------------------------------------

# Bot token used to WRITE into the target server (Discord Developer Portal -> Bot)
BOT_TOKEN=your_bot_token_here

# Your own account token used to READ the source server (selfbot — see README warning)
DC_TOKEN=your_discord_account_token_here

# Who may run !clone. One or more user ids, comma separated.
ALLOWED_ID=your_personal_user_id

# --- Optional -----------------------------------------------------------------

# Milliseconds to wait between API calls. Lower = faster but closer to rate limits.
# Default: 750 (clamped to 0..10000)
CLONE_DELAY_MS=750

# Set to true to only print what would happen, without changing anything.
DRY_RUN=false

# Hard cap on emoji cloned per run, e.g. 25. Unset = unlimited (within slot budget).
# MAX_EMOJIS_PER_RUN=25

# debug | info | warn | error | silent
LOG_LEVEL=info
